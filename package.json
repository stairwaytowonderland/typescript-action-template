{
	"name": "typescript-action-template",
	"description": "GitHub Actions TypeScript template",
	"version": "1.0.0",
	"author": "",
	"type": "module",
	"private": true,
	"homepage": "https://github.com/stairwaytowonderland/typescript-action-template",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stairwaytowonderland/typescript-action-template.git"
	},
	"bugs": {
		"url": "https://github.com/stairwaytowonderland/typescript-action-template/issues"
	},
	"keywords": [
		"actions"
	],
	"exports": {
		".": "./dist/index.js"
	},
	"engines": {
		"node": ">=24.0.0",
		"npm": ">= 8.0.0"
	},
	"scripts": {
		"clean": "rm -rf node_modules package-lock.json && npm cache clean --force",
		"install:safe": "npm install --legacy-peer-deps --node-gyp=./node_modules/.bin/node-gyp",
		"clean-install:safe": "npm run clean && npm run install:safe",
		"build": "npm run fix:format && npm run bundle",
		"bundle": "npm run check && npm run package",
		"ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
		"coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
		"check": "npx concurrently -n check: -c blue,green,red -g npm:check:*",
		"check:format": "npx prettier --check .",
		"check:lint": "npx eslint .",
		"fix": "npx concurrently -n fix: -c cyan,yellow,magenta -g npm:fix:*",
		"fix:format": "npx prettier --write .",
		"fix:lint": "npx eslint --fix .",
		"format-write": "npm run fix:format",
		"format-check": "npm run check:format",
		"lint": "npm run check:lint",
		"local-action": "npx @github/local-action . src/main.ts .env",
		"package": "npx rimraf ./dist && npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
		"package:watch": "npm run package -- --watch",
		"test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest --coverage",
		"preinstall": "npx npm-force-resolutions",
		"postinstall": "printf '\\033[1;32m%s: %s\\033[0m\n' 'Installation complete' 'Run `npm run build` to build the project.'",
		"all": "npm run fix && npm run build && npm test && npm run coverage"
	},
	"license": "MIT",
	"dependencies": {
		"@actions/core": "^3.0.0"
	},
	"devDependencies": {
		"@emnapi/runtime": "^1.11.3",
		"@emnapi/wasi-threads": "^2.1.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@github/local-action": "^7.0.1",
		"@jest/globals": "^30.5.1",
		"@rollup/plugin-commonjs": "^29.0.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.0",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.5.0",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jest": "^29.16.6",
		"eslint-plugin-prettier": "^5.5.5",
		"jest": "^30.5.1",
		"make-coverage-badge": "^1.2.0",
		"prettier": "^3.9.6",
		"rollup": "^4.63.1",
		"semantic-release": "^25.0.8",
		"semantic-release-export-data": "^1.2.0",
		"ts-jest": "^29.4.12",
		"ts-jest-resolver": "^2.0.1",
		"typescript": "^6.0.3"
	},
	"resolutions": {
		"ip-address": "10.31.0"
	},
	"overrides": {
		"node-gyp": {
			"undici": ">=6.28.0 <7.0.0"
		},
		"@actions/github": {
			"undici": ">=6.28.0 <7.0.0"
		},
		"@actions/http-client": {
			"undici": ">=6.28.0 <7.0.0"
		},
		"@semantic-release/github": {
			"undici": ">=7.29.0 <8.0.0"
		}
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "*"
	}
}

{
	"name": "typescript-action-template",
	"description": "GitHub Actions TypeScript template",
	"version": "0.0.0",
	"author": "",
	"type": "module",
	"private": true,
	"homepage": "https://github.com/stairwaytowonderland/typescript-action-template",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stairwaytowonderland/typescript-action-template.git"
	},
	"bugs": {
		"url": "https://github.com/stairwaytowonderland/typescript-action-template/issues"
	},
	"keywords": [
		"actions"
	],
	"exports": {
		".": "./dist/index.js"
	},
	"engines": {
		"node": ">=24.0.0",
		"npm": ">= 8.0.0"
	},
	"scripts": {
		"install:safe": "npm install --legacy-peer-deps --node-gyp=./node_modules/.bin/node-gyp",
		"build": "npm run fix && npm run check && npm run build:compile",
		"build:compile": "printf '\\033[1;32m%s\\033[0m\n' 'Running TypeScript compilation...' && tsc",
		"build:package": "npm run package",
		"bundle": "npm run build && npm run build:package",
		"check": "concurrently -n check: -c blue,green,red,gray -g npm:check:*",
		"check:format": "prettier --check .",
		"check:lint": "eslint .",
		"check:build": "tsc --noEmit",
		"check:test": "tsc --noEmit --project tsconfig.test.json",
		"fix": "concurrently -n fix: -c cyan,yellow,magenta -g npm:fix:*",
		"fix:format": "prettier --write .",
		"fix:lint": "eslint --fix .",
		"local-action": "npx @github/local-action . src/main.ts .env",
		"package": "printf '\\033[1;32m%s\\033[0m\n' 'Packaging project...' && rimraf ./dist && rollup --config rollup.config.ts --configPlugin typescript",
		"package:watch": "printf '\\033[1;32m%s\\033[0m\n' 'Packaging project in watch mode...' && npm run package -- --watch",
		"clean": "npm run clean:modules && npm run clean:cache",
		"clean:modules": "printf '\\033[1;32m%s\\033[0m\n' 'Cleaning node_modules and package-lock.json...' && rm -rf node_modules package-lock.json",
		"clean:cache": "printf '\\033[1;32m%s\\033[0m\n' 'Cleaning npm cache...' && npm cache clean --force",
		"force-resolutions": "printf '\\033[1;32m%s\\033[0m\n' 'Forcing npm resolutions...' && npx npm-force-resolutions",
		"format-write": "npm run fix:format",
		"format-check": "npm run check:format",
		"lint": "npm run check:lint",
		"test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --coverage",
		"badge": "make-coverage-badge --output-path ./badges/coverage.svg",
		"coverage": "npm test && npm run coverage:badge",
		"typecheck": "npm run check:build",
		"coverage:badge": "printf '\\033[1;32m%s\\033[0m\n' 'Generating coverage badge...' && npm run badge",
		"coverage:purge": "printf '\\033[1;32m%s\\033[0m\n' 'Purging coverage directory...' && rm -rf coverage/*",
		"coverage:summary": "npm run command:jq:check && npm run coverage:jq:summary || npm run command:jq:notfound",
		"coverage:jq:summary": "printf '\\033[1;32m%s\\033[0m\n' 'Coverage summary totals...' && cat coverage/coverage-summary.json | (jq -c .total 2>/dev/null || printf '\\033[1;31m(X) %s\\033[0m\n' 'Failed to parse coverage summary.')",
		"command:jq:check": "command -v jq >/dev/null 2>&1",
		"command:jq:notfound": "printf '\\033[1;33m(!) %s\\033[0m\n' '`jq` not found, skipping coverage summary.'",
		"pretest": "printf '\\033[1;32m%s\\033[0m\n' 'Running tests with coverage...'",
		"posttest": "npm run coverage:summary",
		"preinstall": "npx npm-force-resolutions && printf '\\033[1;32m%s\\033[0m\n' 'Installing dependencies...'",
		"postinstall": "printf '\\033[1;32m%s: %s\\033[0m\n' 'Installation complete' 'Run `npm run build` to build the project.'",
		"reset": "npm run clean && npm install",
		"all": "npm run reset && npm test && npm run bundle && npm run coverage:badge"
	},
	"license": "MIT",
	"dependencies": {
		"@actions/core": "^3.0.0"
	},
	"devDependencies": {
		"@emnapi/runtime": "^1.11.3",
		"@emnapi/wasi-threads": "^2.0.1",
		"@eslint/compat": "^2.0.2",
		"@eslint/eslintrc": "^3.3.6",
		"@eslint/js": "^10.0.1",
		"@github/local-action": "^7.0.1",
		"@github/prettier-config": "^0.0.6",
		"@jest/globals": "^30.2.0",
		"@rollup/plugin-commonjs": "^29.0.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.0",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.1.2",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"concurrently": "^10.0.5",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-github": "^6.0.0",
		"eslint-plugin-jest": "^29.16.0",
		"eslint-plugin-prettier": "^5.5.5",
		"globals": "^17.4.0",
		"jest": "^30.2.0",
		"make-coverage-badge": "^1.2.0",
		"prettier": "3.9.8",
		"rimraf": "^6.1.3",
		"rollup": "^4.62.5",
		"rollup-plugin-license": "^3.7.1",
		"semantic-release": "^25.0.8",
		"semantic-release-export-data": "^1.2.0",
		"ts-jest": "^29.4.12",
		"ts-jest-resolver": "^2.0.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0"
	},
	"resolutions": {
		"ip-address": "10.31.0"
	},
	"overrides": {
		"node-gyp": {
			"undici": ">=6.28.0 <7.0.0"
		},
		"@actions/github": {
			"undici": ">=6.28.0 <7.0.0"
		},
		"@actions/http-client": {
			"undici": ">=6.28.0 <7.0.0"
		},
		"@semantic-release/github": {
			"undici": ">=7.29.0 <8.0.0"
		}
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "*"
	}
}

{
	"$schema": "https://typedoc.org/schema.json",
	"name": "Toolkit",
	"readme": "none",
	"out": "./docs",
	"disableSources": false,
	"plugin": ["typedoc-plugin-coverage", "typedoc-plugin-markdown"],
	"entryPointStrategy": "expand",
	"entryPoints": ["."],
	"sort": ["kind", "instance-first", "required-first", "alphabetical"],
	"sortEntryPoints": true,
	"coverageLabel": "Documented",
	"coverageColor": "#5330c8",
	"coverageOutputPath": "./badges/documentation.svg",
	"coverageOutputType": "svg",
	"coverageSvgWidth": 120,
	"pageTitleTemplates": {
		"index": "{projectName} Reference"
	},
	"exclude": ["**/__tests__/**", "**/__fixtures__/**", "**/__utils__/**", "**/docs/**", "**/*.test.ts", "index.ts"]
}

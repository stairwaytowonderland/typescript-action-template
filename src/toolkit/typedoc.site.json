{
	"$schema": "https://typedoc.org/schema.json",
	"name": "Toolkit",

	"entryPoints": ["./*.ts"],
	"sort": ["kind", "instance-first", "required-first", "alphabetical"],
	"sortEntryPoints": true,
	"tsconfig": "../../tsconfig.json",
	"readme": "docs/.index.md",

	"plugin": ["@clean-jsdoc-theme/typedoc"],
	"outputs": [{ "name": "clean-jsdoc-theme", "path": "docs-site" }],
	"exclude": [
		"**/node_modules/**",
		"**/dist/**",
		"**/__tests__/**",
		"**/__fixtures__/**",
		"**/__utils__/**",
		"**/docs/**",
		"**/*.test.ts",
		"index.ts"
	],

	"cleanJsdocTheme": {
		"siteName": "Typescript Action Toolkit",
		"menu": [
			{ "id": "home", "title": "Home" },
			{
				"title": "GitHub",
				"link": "https://github.com/stairwaytowonderland/typescript-action-template",
				"icon": "simpleicons:github"
			},
			{
				"title": "Author Profile",
				"link": "https://github.com/andrewhaller",
				"icon": "simpleicons:github"
			},
			{
				"title": "Clean JSDoc Theme",
				"link": "https://ankdev.me/clean-jsdoc-theme",
				"icon": "lucide:book-open-text"
			}
		],
		"sectionOrder": ["Globals", "Namespaces", "Classes", "Modules", "GitHub Script Modules", "Utilities", "Typedefs"]
	}
}

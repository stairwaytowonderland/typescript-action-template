{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run 'Kitchen Sink' Build Script (shell)",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared"
			},
			"problemMatcher": [],
			"type": "shell",
			"command": "${workspaceFolder}/script/build",
			"args": ["time:all"]
		},
		{
			"label": "CI Checks (npm)",
			"type": "npm",
			"script": "cicd:build",
			"problemMatcher": []
		},
		{
			"label": "Unit Tests (npm)",
			"type": "npm",
			"script": "test",
			"problemMatcher": []
		},
		{
			"label": "Test Local (npm)",
			"type": "npm",
			"script": "start",
			"problemMatcher": []
		},
		{
			"label": "CI Checks and Unit Tests (npm)",
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared"
			},
			"problemMatcher": [],
			"dependsOrder": "sequence",
			"dependsOn": ["CI Checks (npm)", "Unit Tests (npm)"]
		},
		{
			"label": "Fix Prettier Formatting (npm)",
			"type": "npm",
			"script": "fix:format",
			"problemMatcher": []
		},
		{
			"label": "Fix ESLint Issues (npm)",
			"type": "npm",
			"script": "fix:lint",
			"problemMatcher": []
		},
		{
			"label": "Fix All (npm)",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared"
			},
			"problemMatcher": [],
			"dependsOrder": "sequence",
			"dependsOn": ["Fix Prettier Formatting (npm)", "Fix ESLint Issues (npm)"]
		},
		{
			"label": "Generate Coverage (npm)",
			"type": "npm",
			"script": "coverage",
			"problemMatcher": []
		},
		{
			"label": "Bundle (npm)",
			"type": "npm",
			"script": "bundle",
			"problemMatcher": []
		},
		{
			"label": "Generate Documentation (npm)",
			"type": "npm",
			"script": "docs",
			"problemMatcher": []
		},
		{
			"label": "Package (npm)",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared"
			},
			"problemMatcher": [],
			"dependsOrder": "sequence",
			"dependsOn": [
				"Fix All (npm)",
				"Unit Tests (npm)",
				"Generate Coverage (npm)",
				"Bundle (npm)",
				"Generate Documentation (npm)"
			]
		}
	]
}
